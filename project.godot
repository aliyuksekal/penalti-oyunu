; Engine configuration file.
; Godot 4.7 — Penaltı Ustası

config_version=5

[application]

config/name="Penaltı Ustası"
config/description="Penalty shootout against an AI that learns your habits."
config/version="1.0.0"
run/main_scene="res://scenes/main.tscn"
config/quit_on_go_back=false
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/icons/icon_192.png"
boot_splash/bg_color=Color(0.03, 0.07, 0.2, 1)
boot_splash/show_image=true
boot_splash/image="res://assets/icons/splash.png"
boot_splash/fullsize=false
boot_splash/use_filter=true

[autoload]

I18n="*res://scripts/autoload/i18n.gd"
Settings="*res://scripts/autoload/settings.gd"
Assets="*res://scripts/autoload/assets.gd"
Kits="*res://scripts/autoload/kits.gd"
Save="*res://scripts/autoload/save.gd"
Sfx="*res://scripts/autoload/sfx.gd"
UiTheme="*res://scripts/autoload/ui_theme.gd"
Ads="*res://scripts/autoload/ads.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/resizable=true
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=6

[gui]

common/drop_mouse_on_gui_input_disabled=true

[importer_defaults]

texture={
"mipmaps/generate": true
}

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=3
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=2
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=2
environment/defaults/default_clear_color=Color(0.03, 0.06, 0.15, 1)
